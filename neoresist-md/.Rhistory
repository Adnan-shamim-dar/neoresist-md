library(TCGAbiolinks)
if (!require("BiocManager", quietly = TRUE))
install.packages("BiocManager")
BiocManager::install(c("TCGAbiolinks", "maftools"))
library(TCGAbiolinks)
library(maftools)
# Query ALL SARC MAFs
query <- GDCquery(
project = "TCGA-SARC",
data.category = "Simple Nucleotide Variation",
data.type = "Masked Somatic Mutation",
workflow.type = "Mutect2 Variant Aggregation and Masking"
)
# FIXED SARC query
query <- GDCquery(
project = "TCGA-SARC",
data.category = "Simple Nucleotide Variation",
data.type = "Masked Somatic Mutation",
workflow.type = "Aliquot Ensemble Somatic Variant Merging and Masking"
)
print(query)  # <- This will show files
# Download
GDCdownload(query)
# Prepare & Export FIRST case
maf_list <- GDCprepare(query)
write.table(maf_list[[1]]@data, "tcga_sarc_case1.tsv", sep="\t", quote=FALSE, row.names=FALSE)
# Load prepared data (list of MAF file paths)
maf_files <- GDCprepare(query)
print(maf_files)  # Shows paths like c("GDCdata/TCGA-AB-2803-01...maf", ...)
# Create data/ folder & export FIRST case as TSV
dir.create("data", showWarnings = FALSE)
first_maf_path <- maf_files[1]
first_case <- read.maf(maf = first_maf_path)
# Load prepared data (list of MAF file paths)
maf_files <- GDCprepare(query)
print(maf_files)  # Shows paths like c("GDCdata/TCGA-AB-2803-01...maf", ...)
# Create data/ folder & export FIRST case as TSV
dir.create("data", showWarnings = FALSE)
first_maf_path <- maf_files[1]
first_case <- read.maf(maf = first_maf_path)
# maf_files IS the full cohort MAF tibble (17k mutations)
head(maf_files)  # Quick peek
summary(maf_files$Tumor_Sample_Barcode)  # Samples
# Export FULL cohort → NeoVax ready
dir.create("data", showWarnings = FALSE)
write.table(maf_files, "data/tcga_sarc_full_cohort.tsv", sep="\t", quote=FALSE, row.names=FALSE)
print("✅ FULL COHORT: data/tcga_sarc_full_cohort.tsv (17,453 mutations)")
# Extract FIRST sample only (for single-case test)
first_sample <- unique(maf_files$Tumor_Sample_Barcode)[1]
case1_data <- maf_files[maf_files$Tumor_Sample_Barcode == first_sample, ]
write.table(case1_data, "data/tcga_sarc_case1.tsv", sep="\t", quote=FALSE, row.names=FALSE)
print(paste("✅ CASE 1:", first_sample, nrow(case1_data), "mutations"))
# Cohort manifest
manifest <- data.frame(
cancer = "SARC",
total_samples = length(unique(maf_files$Tumor_Sample_Barcode)),
total_mutations = nrow(maf_files),
samples = paste(unique(maf_files$Tumor_Sample_Barcode), collapse="; ")
)
write.csv(manifest, "data/sarc_manifest.csv", row.names=FALSE)
print(manifest)
print("🎉 READY - Run NeoVax on data/tcga_sarc_case1.tsv")
# Check where R saved files
list.files(pattern="*.tsv", full.names=TRUE)
getwd()  # R working directory
# Copy to neoresist-md/ data folder
dir.create("C:/Users/rambe/Documents/neovax/neoresist-md/data", showWarnings=FALSE, recursive=TRUE)
file.copy("data/tcga_sarc_case1.tsv", "C:/Users/rambe/Documents/neovax/neoresist-md/data/tcga_sarc_case1.tsv", overwrite=TRUE)
file.copy("data/sarc_manifest.csv", "C:/Users/rambe/Documents/neovax/neoresist-md/data/sarc_manifest.csv", overwrite=TRUE)
print("✅ Copied to neoresist-md/data/")
# Top 6 samples → cases 2-6
samples <- head(unique(maf_files$Tumor_Sample_Barcode), 6)
for(i in 2:6) {
case_data <- maf_files[maf_files$Tumor_Sample_Barcode == samples[i], ]
outfile <- paste0("data/tcga_sarc_case", i, ".tsv")
write.table(case_data, outfile, sep="\t", quote=FALSE, row.names=FALSE)
print(paste("✅ CASE", i, samples[i], nrow(case_data), "mutations →", outfile))
}
# Check R working directory vs files
getwd()
list.files("data", pattern="tcga_sarc_case", full.names=TRUE)
# Copy ALL to neoresist-md
target_dir <- "C:/Users/rambe/Documents/neovax/neoresist-md/data"
dir.create(target_dir, showWarnings=FALSE, recursive=TRUE)
file.copy(list.files("data", pattern="tcga_sarc_case", full.names=TRUE), target_dir, overwrite=TRUE)
print("✅ ALL 6 cases copied to neoresist-md/data/")
samples <- unique(maf_files$Tumor_Sample_Barcode)
for(i in 1:length(samples)) {
case_data <- maf_files[maf_files$Tumor_Sample_Barcode == samples[i], ]
outfile <- paste0("data/tcga_sarc_case", sprintf("%03d", i), ".tsv")
write.table(case_data, outfile, sep="\t", quote=FALSE, row.names=FALSE)
if(i %% 10 == 0) print(paste("✅ Exported", i, "of 238"))
}
print("🏆 FULL COHORT EXPORTED")
# Find exported files
exported_files <- list.files(pattern="tcga_sarc_case.*\\.tsv", full.names=TRUE)
print(paste("Found", length(exported_files), "files"))
print(head(exported_files))
# Copy to neoresist-md/data/
target_dir <- "C:/Users/rambe/Documents/neovax/neoresist-md/data"
dir.create(target_dir, showWarnings=FALSE, recursive=TRUE)
file.copy(exported_files, target_dir, overwrite=TRUE)
print(paste("✅ Copied", length(exported_files), "to", target_dir))
# Split cohort tibble → 238 per-patient files
setwd("C:/Users/rambe/Documents/neovax/neoresist-md")
dir.create("data", showWarnings=FALSE)
samples <- unique(maf_files$Tumor_Sample_Barcode)
cat("Splitting", length(samples), "samples...\n")
for(i in seq_along(samples)) {
patient_data <- maf_files[maf_files$Tumor_Sample_Barcode == samples[i], ]
outfile <- sprintf("data/sarc_%s.tsv", gsub("-|\\.", "_", samples[i]))  # sarc_TCGA_3B_A9HO_01A_11D_A387_09.tsv
write.table(patient_data, outfile, sep="\t", quote=FALSE, row.names=FALSE, col.names=TRUE)
if(i %% 50 == 0) cat(sprintf("Processed %d/%d samples\n", i, length(samples)))
}
cat(sprintf("🏆 Split %d patients → data/sarc_*.tsv\n", length(samples)))
# Verify
files <- list.files("data", pattern="sarc_.*\\.tsv", full.names=TRUE)
cat(sprintf("✅ %d patient files created\n", length(files)))
cat("Sample sizes:\n")
sizes <- sapply(files[1:10], function(f) nrow(read.table(f, header=TRUE, sep="\t", nrows=1e6)))
print(summary(sizes))
# SPLIT COHORT → 238 PATIENT FILES
setwd("C:/Users/rambe/Documents/neovax/neoresist-md")
dir.create("data", FALSE)
samples <- unique(maf_files$Tumor_Sample_Barcode)
print(paste("Splitting", length(samples), "patients..."))
for(i in seq_along(samples)) {
patient_data <- maf_files[maf_files$Tumor_Sample_Barcode == samples[i], ]
outfile <- paste0("data/sarc_", gsub("[-\\.]", "_", samples[i]), ".tsv")
write.table(patient_data, outfile, sep="\t", quote=FALSE, row.names=FALSE)
if(i == 1 || i == length(samples) || i %% 50 == 0) {
print(paste("✅", i, "of", length(samples), "→", tail(outfile,1)))
}
}
print("🏆 238 PATIENT FILES READY")
